# Unix
#PTHREAD=	# for Mac
PTHREAD=-pthread
AR=emar
#AS=emas
RANLIB=emranlib
CC=emcc
CFLAGS=-Wall -Wno-missing-braces -ggdb -I$(ROOT) -I$(ROOT)/include -I$(ROOT)/kern -c -D_THREAD_SAFE $(PTHREAD) -O2
O=o
OS=wasm
GUI=wasm
LDADD=-lm
LDFLAGS=$(PTHREAD) -sPROXY_TO_PTHREAD=1 -sPTHREAD_POOL_SIZE=8 -sASSERTIONS=2 -sINITIAL_MEMORY=128MB -lwebsocket.js
TARG=drawterm.js
AUDIO=none
# AUDIO=alsa

all: default

wasm-factotum.$O: posix-factotum.$O
	cp $^ $@
